{
  "openapi": "3.1.0",
  "info": {
    "title": "Biometric enrollment and attendance",
    "version": "1.1.0"
  },
  "paths": {
    "/api/v1/biometrics/students": {
      "get": {
        "summary": "Select students for biometric management",
        "description": "School-only, live biometrics.enroll OR biometrics.revoke permission. Minimal identity metadata; broader academic/student permissions are unchanged.",
        "security": [
          {
            "UserCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success; existing data/request_id envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Student"
                      }
                    },
                    "request_id": {
                      "type": "string"
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "page": {
                          "type": "integer"
                        },
                        "page_size": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "page",
                        "page_size",
                        "total"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "data",
                    "request_id",
                    "pagination"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Strict payload validation error"
          },
          "401": {
            "description": "Session unauthenticated/expired"
          },
          "403": {
            "description": "Permission, Origin or CSRF rejected"
          },
          "503": {
            "description": "Service unavailable; no automatic attendance"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "search",
            "schema": {
              "type": "string",
              "maxLength": 100
            },
            "description": "Trimmed search, <=100 UTF-8 bytes."
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ]
      }
    },
    "/api/v1/students/{id}/face-status": {
      "get": {
        "summary": "Read face registration and evaluation status",
        "description": "Live biometrics.enroll OR biometrics.revoke, current school/student. Never returns ciphertext, nonce, key or plaintext embedding.",
        "security": [
          {
            "UserCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success; existing data/request_id envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/FaceStatus"
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "data",
                    "request_id"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Strict payload validation error"
          },
          "401": {
            "description": "Session unauthenticated/expired"
          },
          "403": {
            "description": "Permission, Origin or CSRF rejected"
          },
          "503": {
            "description": "Service unavailable; no automatic attendance"
          }
        }
      },
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ]
    },
    "/api/v1/students/{id}/enrollments": {
      "post": {
        "summary": "Enroll provisional face template",
        "description": "Live biometrics.enroll and active student required in local and production. 3\u20135 distinct quality-checked JPEGs; JSON <=2 MiB. Only encrypted templates stored. Guardian consent is not part of enrollment. Automatic attendance remains disabled until evaluation.",
        "security": [
          {
            "UserCookie": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success; existing data/request_id envelope."
          },
          "400": {
            "description": "Strict payload validation error"
          },
          "401": {
            "description": "Session unauthenticated/expired"
          },
          "403": {
            "description": "Permission, Origin or CSRF rejected"
          },
          "503": {
            "description": "Service unavailable; no automatic attendance"
          },
          "409": {
            "description": "Student is inactive"
          },
          "410": {
            "description": "Consent unavailable, expired or withdrawn"
          },
          "422": {
            "description": "Quality, face count, duplicate frame or identity consistency rejected"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Enrollment"
              }
            }
          }
        }
      },
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ]
    },
    "/api/v1/students/{id}/face-revoke": {
      "post": {
        "summary": "Delete a face template",
        "description": "Live biometrics.revoke + nonempty reason. Ciphertext removal, gallery revision and audit commit together. Attendance history remains.",
        "security": [
          {
            "UserCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success; existing data/request_id envelope."
          },
          "400": {
            "description": "Strict payload validation error"
          },
          "401": {
            "description": "Session unauthenticated/expired"
          },
          "403": {
            "description": "Permission, Origin or CSRF rejected"
          },
          "503": {
            "description": "Service unavailable; no automatic attendance"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Revocation"
              }
            }
          }
        }
      },
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ]
    },
    "/api/v1/kiosk/recognize": {
      "post": {
        "summary": "Detect faces from a paired device",
        "description": "Device cookie + Origin/CSRF, live school/device/operator/session/roster/template checks. JSON <=512 KiB. Stable fresh recognition and liveness record check-in before checkout_at; at/after it record checkout only for already present/late students. No frames are persisted. Mutations are idempotent; repeated frames do not generate new ledger rows. Compatible alias /api/v1/kiosk/recognitions. First obtain event_id from POST /api/v1/kiosk/capture-challenge, then capture a fresh JPEG. Permits expire after 10 seconds and are device-bound and single-use; identical JPEGs are rejected for 24 hours. On a lost response or 409 CAPTURE_REPLAY/RECOGNITION_STALE, obtain a new permit and capture a new frame; never retry the same frame. Authority and gallery are revalidated after inference.",
        "security": [
          {
            "DeviceCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success; existing data/request_id envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Recognition"
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "data",
                    "request_id"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Strict payload validation error"
          },
          "401": {
            "description": "Session unauthenticated/expired"
          },
          "403": {
            "description": "Permission, Origin or CSRF rejected"
          },
          "503": {
            "description": "Service unavailable; no automatic attendance"
          },
          "409": {
            "description": "CAPTURE_REPLAY for a used, expired, foreign-device permit or duplicate JPEG; RECOGNITION_STALE when gallery/device/session changes during inference. Obtain a new permit and fresh frame."
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Capture"
              }
            }
          }
        }
      }
    },
    "/api/v1/students/{id}/face-preview": {
      "post": {
        "summary": "Check enrollment camera frame quality",
        "description": "Live biometrics.enroll and active student, rechecked after inference. Strict JSON <=512 KiB; raw base64 JPEG <=384 KiB and dimensions 160\u20131280. Ephemeral frames; only geometry and quality returned. No guardian consent required.",
        "security": [
          {
            "UserCookie": []
          }
        ],
        "responses": {
          "400": {
            "description": "Strict payload validation error"
          },
          "401": {
            "description": "Session unauthenticated/expired"
          },
          "403": {
            "description": "Permission, Origin or CSRF rejected"
          },
          "503": {
            "description": "Service unavailable; no automatic attendance"
          },
          "409": {
            "description": "Student is inactive"
          },
          "410": {
            "description": "Consent unavailable, expired or withdrawn"
          },
          "422": {
            "description": "JPEG validation or frame dimensions rejected"
          },
          "200": {
            "description": "Success in existing data/request_id envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/FacePreview"
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "data",
                    "request_id"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "maxLength": 524288
                  }
                },
                "required": [
                  "image"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      },
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ]
    },
    "/api/v1/kiosk/capture-challenge": {
      "post": {
        "summary": "Issue a single-use device-bound capture event valid for ten seconds",
        "description": "Requires an active device cookie and matching X-CSRF-Token/Origin. Request before capturing each fresh image. Creating a permit replaces unused permits for that device session.",
        "responses": {
          "201": {
            "description": "data.event_id (UUID) and data.expires_at (date-time)"
          },
          "401": {
            "description": "Device, session, operator authority or assigned class is no longer valid"
          },
          "403": {
            "description": "Origin or CSRF rejected"
          }
        }
      }
    },
    "/api/v1/students/{id}/face-photo": {
      "get": {
        "summary": "Read one private registration reference portrait",
        "description": "Live biometrics.enroll OR biometrics.revoke permission and assigned-class scope, checked again after decryption. Encrypted portrait shares face template lifecycle. Returns private/no-store JSON; unavailable for legacy, revoked or inactive registrations. Kiosk cookies cannot access this endpoint.",
        "security": [
          {
            "UserCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success; existing data/request_id envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "image": {
                          "type": "string",
                          "contentEncoding": "base64",
                          "contentMediaType": "image/jpeg",
                          "maxLength": 87384
                        }
                      },
                      "required": [
                        "image"
                      ],
                      "additionalProperties": false
                    },
                    "request_id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "data",
                    "request_id"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Strict payload validation error"
          },
          "401": {
            "description": "Session unauthenticated/expired"
          },
          "403": {
            "description": "Permission, Origin or CSRF rejected"
          },
          "503": {
            "description": "Portrait temporarily unavailable; enrollment/attendance remain valid"
          },
          "404": {
            "description": "No authorized active student reference portrait"
          }
        }
      },
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ]
    }
  },
  "components": {
    "securitySchemes": {
      "UserCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "attendance_session",
        "description": "__Host-attendance_session on HTTPS"
      },
      "DeviceCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "attendance_device",
        "description": "Configured development device cookie; __Host- variant is used under HTTPS."
      }
    },
    "schemas": {
      "Student": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "full_name": {
            "type": "string"
          },
          "nis": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "inactive",
              "graduated",
              "transferred"
            ]
          },
          "class_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "reference_photo_version": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Current template identifier only when its encrypted reference portrait exists; null for legacy registration."
          }
        },
        "required": [
          "id",
          "full_name",
          "nis",
          "status",
          "class_name",
          "reference_photo_version"
        ],
        "additionalProperties": false
      },
      "Template": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "model_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "frame_count": {
            "type": "integer",
            "minimum": 3,
            "maximum": 5
          },
          "status": {
            "const": "provisional"
          },
          "reference_photo_version": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Current template identifier only when its encrypted reference portrait exists; null for legacy registration."
          }
        },
        "required": [
          "id",
          "created_at",
          "model_sha256",
          "frame_count",
          "status",
          "reference_photo_version"
        ],
        "additionalProperties": false
      },
      "FaceStatus": {
        "type": "object",
        "properties": {
          "enrolled": {
            "type": "boolean"
          },
          "pipeline_ready": {
            "type": "boolean"
          },
          "recognition_enabled": {
            "type": "boolean"
          },
          "block_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "template": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Template"
              },
              {
                "type": "null"
              }
            ]
          },
          "evaluation": {
            "type": "object",
            "properties": {
              "status": {
                "const": "not_evaluated"
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "automatic_attendance_approved": {
                "const": false
              }
            }
          },
          "enrollment_allowed": {
            "type": "boolean",
            "description": "Student is active; enrollment additionally requires live officer permission, valid frames and a ready pipeline."
          }
        },
        "required": [
          "enrolled",
          "pipeline_ready",
          "recognition_enabled",
          "block_reason",
          "template",
          "evaluation",
          "enrollment_allowed"
        ],
        "additionalProperties": false
      },
      "Enrollment": {
        "type": "object",
        "properties": {
          "frames": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 524288,
              "description": "Raw base64 JPEG; decoded <=384 KiB; header dimensions 160\u20131280 per axis, no data URL."
            },
            "minItems": 3,
            "maxItems": 5
          }
        },
        "required": [
          "frames"
        ],
        "additionalProperties": false,
        "description": " One 192\u00d7192 JPEG cropped from the first validated frame is encrypted and retained for visual verification. Remaining source frames are ephemeral. A failed photo validation preserves the previous registration."
      },
      "Revocation": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "reason"
        ],
        "additionalProperties": false
      },
      "Capture": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string",
            "maxLength": 524288,
            "description": "Raw base64 JPEG; decoded <=384 KiB; header dimensions 160\u20131280 per axis, no data URL."
          },
          "event_id": {
            "type": "string",
            "format": "uuid",
            "description": "Server-issued single-use ID from POST /api/v1/kiosk/capture-challenge; valid for 10 seconds and bound to the paired device cookie."
          },
          "track_id": {
            "type": "string",
            "format": "uuid"
          },
          "captured_at": {
            "type": "string",
            "format": "date-time",
            "description": "Within 30 seconds of server time."
          }
        },
        "required": [
          "image",
          "event_id",
          "track_id",
          "captured_at"
        ],
        "additionalProperties": false
      },
      "Recognition": {
        "type": "object",
        "required": [
          "decision",
          "faces",
          "recognition_enabled",
          "block_reason"
        ],
        "properties": {
          "decision": {
            "enum": [
              "no_face",
              "unknown",
              "inconclusive",
              "accepted",
              "verification_required"
            ]
          },
          "faces": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "box": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "width": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "height": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "additionalProperties": false
                },
                "label": {
                  "type": "string"
                },
                "student_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "similarity": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1,
                  "description": "Fresh cosine similarity. Not a probability or accuracy percentage. Omitted when no valid embedding is available."
                }
              },
              "required": [
                "box"
              ],
              "additionalProperties": false
            }
          },
          "recognition_enabled": {
            "type": "boolean"
          },
          "block_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "attendance": {
            "type": "object",
            "properties": {
              "outcome": {
                "enum": [
                  "recorded",
                  "already_recorded",
                  "checked_out",
                  "already_checked_out",
                  "check_in_required",
                  "status_locked",
                  "correction_pending"
                ]
              },
              "record": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "mode": {
                "enum": [
                  "check_in",
                  "check_out"
                ]
              }
            }
          },
          "engine_status": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          },
          "identity_continuous": {
            "type": "boolean",
            "description": "True only for a fresh same-identity match on a previously live-verified track during a PAD recheck. Names may remain visible, but recognition_enabled=false and no attendance mutation is permitted."
          },
          "reference_photo": {
            "type": "string",
            "contentEncoding": "base64",
            "contentMediaType": "image/jpeg",
            "maxLength": 87384,
            "description": "Optional 192\u00d7192 registration portrait, only after runtime-approved recognition with attendance. Never supplied for unknown/unconfirmed faces; excluded from persisted attendance/ledger data."
          }
        },
        "description": "Names come from the live eligible session roster only after fresh stable recognition and liveness evidence. Attendance outcomes distinguish saved arrival/departure from blocked changes; protected manual statuses and pending corrections remain unchanged. Arrival/departure timestamps are server-authoritative and preserved on repeated frames. Unknown responses omit identities. A verification_required response can retain a previously verified live track name after a fresh same-identity match, with identity_continuous=true, no attendance payload and recognition_enabled=false. Unknown or changed faces never inherit a cached identity."
      },
      "FacePreview": {
        "type": "object",
        "properties": {
          "faces": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "box": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "width": {
                      "type": "number",
                      "maximum": 1,
                      "exclusiveMinimum": 0
                    },
                    "height": {
                      "type": "number",
                      "maximum": 1,
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "width",
