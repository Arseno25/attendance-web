    "/api/v1/kiosk/session": {
      "post": {
        "summary": "Pair kiosk to an open session",
        "description": "Operator devices.health login + Origin/CSRF. Consumes a five-minute one-use pairing code and issues an HttpOnly device cookie, Secure on HTTPS. The device remembers the selected class and follows its unique currently open session. Cookie lifetime is 30 days of inactivity, renewed by heartbeat, capped by the original operator class assignment end. Re-pairing invalidates the previous credential; pairing atomically ends operator login. Returns device/class/session labels, session_id, session_ready=true, connection_status=ready, schedule times, server_time, expires_at and device csrf_token.",
        "security": [
          {
            "UserCookie": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success, data envelope and request_id"
          },
          "400": {
            "description": "Validation or malformed JSON"
          },
          "401": {
            "description": "Session/device unauthenticated"
          },
          "403": {
            "description": "Origin, CSRF or role/grant denied"
          },
          "404": {
            "description": "Scoped reference not found"
          },
          "409": {
            "description": "State, expiry, duplicate or hash conflict"
          },
          "503": {
            "description": "Service unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pairing_token": {
                    "type": "string",
                    "minLength": 64,
                    "maxLength": 64
                  },
                  "session_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "pairing_token",
                  "session_id"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/kiosk/me": {
      "get": {
        "summary": "Read active kiosk session",
        "description": "Device cookie; rechecks school, device and original operator authority. Resolves the unique currently open session within the paired class. Returns session_ready and connection_status (ready, waiting_session, multiple_sessions). Session fields are null while waiting; device/class identity and CSRF remain available. No attendance may be captured while waiting.",
        "security": [
          {
            "DeviceCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success, data envelope and request_id"
          },
          "400": {
            "description": "Validation or malformed JSON"
          },
          "401": {
            "description": "Session/device unauthenticated"
          },
          "403": {
            "description": "Origin, CSRF or role/grant denied"
          },
          "404": {
            "description": "Scoped reference not found"
          },
          "409": {
            "description": "State, expiry, duplicate or hash conflict"
          },
          "503": {
            "description": "Service unavailable"
          }
        }
      }
    },
    "/api/v1/kiosk/heartbeat": {
      "post": {
        "summary": "Refresh device heartbeat",
        "description": "Device cookie + exact Origin + device CSRF. Rechecks authority, resolves the next session in the same class and updates last_seen_at. Renews cookie and credential expiry to 30 days from now, never beyond the original class assignment end. Returns the same ready/waiting metadata as kiosk/me. A closed attendance session does not invalidate the device connection.",
        "security": [
          {
            "DeviceCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success, data envelope and request_id"
          },
          "400": {
            "description": "Validation or malformed JSON"
          },
          "401": {
            "description": "Session/device unauthenticated"
          },
          "403": {
            "description": "Origin, CSRF or role/grant denied"
          },
          "404": {
            "description": "Scoped reference not found"
          },
          "409": {
            "description": "State, expiry, duplicate or hash conflict"
          },
          "503": {
            "description": "Service unavailable"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/kiosk/recognitions": {
      "post": {
        "summary": "Recognize and record scheduled arrival/departure",
        "description": "Alias of POST /api/v1/kiosk/recognize. event_id must come from /api/v1/kiosk/capture-challenge, be unused, device-bound and unexpired. Encoded image fingerprints are retained for 24 hours; duplicate images, expired or reused permits return 409 CAPTURE_REPLAY. Take a new image and request another permit; never retry stale image data. The API revalidates operator access and gallery revision after inference. 409 RECOGNITION_STALE means recapture after gallery/session changes.",
        "security": [
          {
            "DeviceCookie": []
          }
        ],
        "responses": {
          "503": {
            "description": "Service unavailable"
          },
          "400": {
            "description": "Validation or malformed JSON"
          },
          "401": {
            "description": "Session/device unauthenticated"
          },
          "403": {
            "description": "Origin, CSRF or role/grant denied"
          },
          "404": {
            "description": "Scoped reference not found"
          },
          "409": {
            "description": "State, expiry, duplicate or hash conflict"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
