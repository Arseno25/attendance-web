{
  "openapi": "3.1.0",
  "info": {
    "title": "Local lifecycle and P1 attendance",
    "version": "1.1.0",
    "description": "Attendance lifecycle, device pairing and imports. Enrollment contracts are in biometrics.json. Automatic recognition remains disabled until evaluated. Guardian and consent endpoints have been retired; historical records remain stored."
  },
  "paths": {
    "/api/v1/devices": {
      "get": {
        "summary": "List scoped devices",
        "description": "devices.health permission; name/location/revoked_at/last_seen_at.",
        "security": [
          {
            "UserCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success, data envelope and request_id"
          },
          "400": {
            "description": "Validation or malformed JSON"
          },
          "401": {
            "description": "Session/device unauthenticated"
          },
          "403": {
            "description": "Origin, CSRF or role/grant denied"
          },
          "404": {
            "description": "Scoped reference not found"
          },
          "409": {
            "description": "State, expiry, duplicate or hash conflict"
          },
          "503": {
            "description": "Service unavailable"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ]
      },
      "post": {
        "summary": "Register device",
        "description": "devices.manage permission.",
        "security": [
          {
            "UserCookie": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success, data envelope and request_id"
          },
          "400": {
            "description": "Validation or malformed JSON"
          },
          "401": {
            "description": "Session/device unauthenticated"
          },
          "403": {
            "description": "Origin, CSRF or role/grant denied"
          },
          "404": {
            "description": "Scoped reference not found"
          },
          "409": {
            "description": "State, expiry, duplicate or hash conflict"
          },
          "503": {
            "description": "Service unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "location": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                },
                "required": [
                  "name",
                  "location"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/devices/{id}/revoke": {
      "post": {
        "summary": "Revoke device immediately",
        "description": "devices.manage; deletes all device sessions and pairing tokens in same transaction.",
        "security": [
          {
            "UserCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success, data envelope and request_id"
          },
          "400": {
            "description": "Validation or malformed JSON"
          },
          "401": {
            "description": "Session/device unauthenticated"
          },
          "403": {
            "description": "Origin, CSRF or role/grant denied"
          },
          "404": {
            "description": "Scoped reference not found"
          },
          "409": {
            "description": "State, expiry, duplicate or hash conflict"
          },
          "503": {
            "description": "Service unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "reason"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/devices/{id}/pairing-token": {
      "post": {
        "summary": "Issue one-time pairing token",
        "description": "devices.manage; random 256-bit token, hashed server storage, five-minute expiry. Response pairing_token/expires_at, no-store; previous token invalidated.",
        "security": [
          {
            "UserCookie": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success, data envelope and request_id"
          },
          "400": {
            "description": "Validation or malformed JSON"
          },
          "401": {
            "description": "Session/device unauthenticated"
          },
          "403": {
            "description": "Origin, CSRF or role/grant denied"
          },
          "404": {
            "description": "Scoped reference not found"
          },
          "409": {
            "description": "State, expiry, duplicate or hash conflict"
          },
          "503": {
            "description": "Service unavailable"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/kiosk/session-options": {
      "get": {
        "summary": "Discover eligible pairing sessions",
        "description": "devices.health user session required; paginated id/name/class_name/created_at only, status open and clock within starts/closes. No student roster/identities.",
        "security": [
          {
            "UserCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success, data envelope and request_id"
          },
          "400": {
            "description": "Validation or malformed JSON"
          },
          "401": {
            "description": "Session/device unauthenticated"
          },
          "403": {
            "description": "Origin, CSRF or role/grant denied"
          },
          "404": {
            "description": "Scoped reference not found"
          },
          "409": {
            "description": "State, expiry, duplicate or hash conflict"
          },
          "503": {
            "description": "Service unavailable"
          }
        }
      }
    },
    "/api/v1/kiosk/session": {
      "post": {
        "summary": "Pair kiosk to an open session",
        "description": "Operator devices.health user login + Origin/CSRF; consumes token once, ten-minute HttpOnly device cookie. Re-pairing device invalidates previous cookie. User session revoked atomically and user cookie cleared; device cookie remains. No identity in response. Response includes class_name, timezone, server_time and snapshotted starts_at/late_after/checkout_at/closes_at for scheduled automatic departure.",
        "security": [
          {
            "UserCookie": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success, data envelope and request_id"
          },
          "400": {
            "description": "Validation or malformed JSON"
          },
          "401": {
            "description": "Session/device unauthenticated"
          },
          "403": {
            "description": "Origin, CSRF or role/grant denied"
          },
          "404": {
            "description": "Scoped reference not found"
          },
          "409": {
            "description": "State, expiry, duplicate or hash conflict"
          },
          "503": {
            "description": "Service unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pairing_token": {
                    "type": "string",
                    "minLength": 64,
                    "maxLength": 64
                  },
                  "session_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "pairing_token",
                  "session_id"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/kiosk/me": {
      "get": {
        "summary": "Read active kiosk session",
        "description": "Device cookie; rechecks school/device/attendance session active and unexpired. Returns device/session/class labels, timezone, starts_at, late_after, checkout_at, closes_at, server_time, expires_at, device csrf_token and current recognition readiness.",
        "security": [
          {
            "DeviceCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success, data envelope and request_id"
          },
          "400": {
            "description": "Validation or malformed JSON"
          },
          "401": {
            "description": "Session/device unauthenticated"
          },
          "403": {
            "description": "Origin, CSRF or role/grant denied"
          },
          "404": {
            "description": "Scoped reference not found"
          },
          "409": {
            "description": "State, expiry, duplicate or hash conflict"
          },
          "503": {
            "description": "Service unavailable"
          }
        }
      }
    },
    "/api/v1/kiosk/heartbeat": {
      "post": {
        "summary": "Refresh device heartbeat",
        "description": "Device cookie + exact Origin + device CSRF; does not extend session expiry.",
        "security": [
          {
            "DeviceCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success, data envelope and request_id"
          },
          "400": {
            "description": "Validation or malformed JSON"
          },
          "401": {
            "description": "Session/device unauthenticated"
          },
          "403": {
            "description": "Origin, CSRF or role/grant denied"
          },
          "404": {
            "description": "Scoped reference not found"
          },
          "409": {
            "description": "State, expiry, duplicate or hash conflict"
          },
          "503": {
            "description": "Service unavailable"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/kiosk/recognitions": {
      "post": {
        "summary": "Recognize and record scheduled arrival/departure",
        "description": "Alias of /api/v1/kiosk/recognize; see biometrics.json. Fresh stable identity and liveness required. Departure follows the session checkout_at snapshot; no frame persistence.",
        "security": [
          {
            "DeviceCookie": []
          }
        ],
        "responses": {
          "503": {
            "description": "Service unavailable"
          },
          "400": {
            "description": "Validation or malformed JSON"
          },
          "401": {
            "description": "Session/device unauthenticated"
          },
          "403": {
            "description": "Origin, CSRF or role/grant denied"
          },
          "404": {
            "description": "Scoped reference not found"
          },
          "409": {
            "description": "State, expiry, duplicate or hash conflict"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/students/imports/dry-run": {
      "post": {
        "summary": "Preview CSV import",
        "description": "students.write; max 128 KiB JSON/500 rows, UTF-8 header nis,nisn,full_name. Returns id/hash/expires_at/valid/row_count/errors[{row,message}]/preview rows. Server payload bound to creator, school, class; fifteen-minute expiry.",
        "security": [
          {
            "UserCookie": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success, data envelope and request_id"
          },
          "400": {
            "description": "Validation or malformed JSON"
          },
          "401": {
            "description": "Session/device unauthenticated"
          },
          "403": {
            "description": "Origin, CSRF or role/grant denied"
          },
          "404": {
            "description": "Scoped reference not found"
          },
          "409": {
            "description": "State, expiry, duplicate or hash conflict"
          },
          "503": {
            "description": "Service unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "class_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "csv": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "class_id",
                  "csv"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/students/imports/{id}/commit": {
      "post": {
        "summary": "Commit entire verified batch",
        "description": "Creator and students.write only. Revalidates live class, unique NIS and placements in one transaction. Invalid/expired/hash mismatch 409. Retry committed batch returns same imported count. Clears payload after commit.",
        "security": [
          {
            "UserCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success, data envelope and request_id"
          },
          "400": {
            "description": "Validation or malformed JSON"
          },
          "401": {
            "description": "Session/device unauthenticated"
          },
          "403": {
            "description": "Origin, CSRF or role/grant denied"
          },
          "404": {
            "description": "Scoped reference not found"
          },
          "409": {
            "description": "State, expiry, duplicate or hash conflict"
          },
          "503": {
            "description": "Service unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "hash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "hash"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/attendances/check-out": {
      "post": {
        "summary": "Record verified manual departure",
        "description": "attendance.manual; open session within window, present/late check-in prerequisite, no pending correction. Server time, first checkout preserved, actor-scoped event UUID/fingerprint. Response outcome and record including check_out_at/version. Changed payload 409; audit/event/ledger atomic.",
        "security": [
          {
            "UserCookie": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success, data envelope and request_id"
          },
          "400": {
            "description": "Validation or malformed JSON"
          },
          "401": {
            "description": "Session/device unauthenticated"
          },
          "403": {
            "description": "Origin, CSRF or role/grant denied"
          },
          "404": {
            "description": "Scoped reference not found"
          },
          "409": {
            "description": "State, expiry, duplicate or hash conflict"
          },
          "503": {
            "description": "Service unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "event_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "session_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "student_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "event_id",
                  "session_id",
                  "student_id",
                  "reason"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/ws/attendance": {
      "get": {
        "summary": "WebSocket invalidation for one scoped session",
        "description": "Exact Origin + user cookie required. session_id mandatory; teacher live class assignment enforced. Messages {event:attendance.changed} only. REST refetch on reconnect; no replay or PII. Revalidate every two seconds; revoked/expired auth closes1008. Max32/instance,30minute connection lifetime,256-byte incoming, ping20sec/pong45sec, bounded writes.",
        "security": [
          {
            "UserCookie": []
          }
        ],
        "responses": {
          "101": {
            "description": "Success, data envelope and request_id"
          },
          "400": {
            "description": "Validation or malformed JSON"
          },
          "401": {
            "description": "Session/device unauthenticated"
          },
          "403": {
            "description": "Origin, CSRF or role/grant denied"
          },
          "404": {
            "description": "Scoped reference not found"
          },
          "409": {
            "description": "State, expiry, duplicate or hash conflict"
          },
          "503": {
            "description": "Service unavailable"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "session_id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "UserCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "attendance_session",
        "description": "__Host-attendance_session on HTTPS"
      },
      "DeviceCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "attendance_device",
        "description": "__Host-attendance_device on HTTPS"
      }
    }
  }
}
