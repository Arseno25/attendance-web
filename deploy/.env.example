# Examples only. Configure private DB and generated secrets in Coolify.
DATABASE_URL=postgresql://attendance_app:replace-in-coolify@private-db-host:5432/attendance?sslmode=require
MIGRATION_DATABASE_URL=postgresql://attendance_migrator:replace-in-coolify@private-db-host:5432/attendance?sslmode=require
WEB_ORIGIN=https://attendance.example.com
NUXT_PUBLIC_API_BASE=https://api.attendance.example.com/api/v1
AI_SERVICE_TOKEN=CHANGE_ME
AI_BASE_URL=http://ai:8001
AI_MODELS_DIR=/models
AI_TEMPLATE_KEY_BASE64=CHANGE_ME_32_RANDOM_BYTES_BASE64
AI_TEMPLATE_KEY_ID=local-v1

# Trust only the private reverse-proxy address/subnet; empty means ignore forwarded IP headers.
TRUSTED_PROXY_CIDRS=
# Provisional settings; recalibrate using independent camera samples.
AI_MATCH_THRESHOLD=0.8
AI_MATCH_MARGIN=0.1
AI_LIVENESS_THRESHOLD=0.95
AI_DUPLICATE_THRESHOLD=0.85
# Leave empty until a camera report passes review; mount that exact file read-only.
AI_RECOGNITION_APPROVAL_PATH=
AI_RECOGNITION_APPROVAL_SHA256=
