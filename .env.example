# Local development only; `make setup` generates random local secrets in .env.
POSTGRES_DB=attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=replace-with-random-local-password
DATABASE_URL=postgresql://attendance:replace-with-random-local-password@127.0.0.1:54329/attendance?sslmode=disable
API_ADDRESS=127.0.0.1:8080
WEB_ORIGIN=http://localhost:3001
NUXT_PUBLIC_API_BASE=http://localhost:8080/api/v1
NUXT_PORT=3001
AI_SERVICE_TOKEN=replace-with-at-least-32-random-characters
AI_BASE_URL=http://127.0.0.1:8001
AI_MODELS_DIR=../../.tools/models
AI_TEMPLATE_KEY_BASE64=replace-with-32-random-bytes-base64
AI_TEMPLATE_KEY_ID=local-v1

# Trust only the private reverse-proxy address/subnet; empty means ignore forwarded IP headers.
TRUSTED_PROXY_CIDRS=
AI_MATCH_THRESHOLD=0.8
AI_MATCH_MARGIN=0.1
AI_LIVENESS_THRESHOLD=0.95
AI_DUPLICATE_THRESHOLD=0.85
AI_RECOGNITION_APPROVAL_PATH=
AI_RECOGNITION_APPROVAL_SHA256=
