    "/api/v1/kiosk/session-options": {
      "get": {
        "summary": "Discover eligible pairing sessions",
        "description": "devices.health user session required; paginated id/name/class_name/created_at only, status open and clock within starts/closes. No student roster/identities.",
        "security": [
          {
            "UserCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success, data envelope and request_id"
