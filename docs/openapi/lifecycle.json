              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/ws/attendance": {
      "get": {
        "summary": "WebSocket invalidation for one scoped session",
        "description": "Exact Origin + user cookie required. session_id mandatory; teacher live class assignment enforced. Messages {event:attendance.changed} only. REST refetch on reconnect; no replay or PII. Revalidate every two seconds; revoked/expired auth closes1008. Max32/instance,30minute connection lifetime,256-byte incoming, ping20sec/pong45sec, bounded writes.",
        "security": [
          {
            "UserCookie": []
          }
        ],
        "responses": {
          "101": {
            "description": "Success, data envelope and request_id"
          },
          "400": {
            "description": "Validation or malformed JSON"
          },
          "401": {
            "description": "Session/device unauthenticated"
          },
          "403": {
            "description": "Origin, CSRF or role/grant denied"
          },
          "404": {
            "description": "Scoped reference not found"
          },
          "409": {
            "description": "State, expiry, duplicate or hash conflict"
          },
          "503": {
            "description": "Service unavailable"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "session_id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/kiosk/capture-challenge": {
      "post": {
        "summary": "Issue a single-use device-bound capture event valid for ten seconds",
        "description": "Requires an active device cookie and matching X-CSRF-Token/Origin. Request before capturing each fresh image. Creating a permit replaces unused permits for that device session.",
        "responses": {
          "201": {
            "description": "data.event_id (UUID) and data.expires_at (date-time)"
          },
          "401": {
            "description": "Device, session, operator authority or assigned class is no longer valid"
          },
          "403": {
            "description": "Origin or CSRF rejected"
          }
        }
      }
    },
    "/api/v1/kiosk/recognize": {
      "post": {
        "summary": "Recognize and record scheduled arrival/departure",
        "description": "Alias of POST /api/v1/kiosk/recognize. event_id must come from /api/v1/kiosk/capture-challenge, be unused, device-bound and unexpired. Encoded image fingerprints are retained for 24 hours; duplicate images, expired or reused permits return 409 CAPTURE_REPLAY. Take a new image and request another permit; never retry stale image data. The API revalidates operator access and gallery revision after inference. 409 RECOGNITION_STALE means recapture after gallery/session changes.",
        "security": [
          {
            "DeviceCookie": []
          }
        ],
        "responses": {
          "503": {
            "description": "Service unavailable"
          },
          "400": {
            "description": "Validation or malformed JSON"
          },
          "401": {
            "description": "Session/device unauthenticated"
          },
          "403": {
            "description": "Origin, CSRF or role/grant denied"
          },
          "404": {
            "description": "Scoped reference not found"
          },
          "409": {
            "description": "State, expiry, duplicate or hash conflict"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "UserCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "attendance_session",
        "description": "__Host-attendance_session on HTTPS"
      },
      "DeviceCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "attendance_device",
        "description": "__Host-attendance_device on HTTPS"
      }
    }
  }
}
