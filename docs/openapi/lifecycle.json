{
  "openapi": "3.1.0",
  "info": {
    "title": "Local lifecycle and P1 attendance",
    "version": "1.0.0",
    "description": "Core independent of AI evaluation. Enrollment and automatic recognition disabled until master plan G2/G3. JSON responses data/request_id; errors error.code/message/request_id. Audit omits secret tokens and evidence."
  },
  "paths": {
    "/api/v1/students/{id}/guardians": {
      "get": {
        "summary": "Read private guardians",
        "description": "consents.manage grant only; teachers/operators denied. No raw evidence upload.",
        "security": [
          {
            "UserCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success, data envelope and request_id"
          },
          "400": {
            "description": "Validation or malformed JSON"
          },
          "401": {
            "description": "Session/device unauthenticated"
          },
          "403": {
            "description": "Origin, CSRF or role/grant denied"
          },
          "404": {
            "description": "Scoped reference not found"
          },
          "409": {
            "description": "State, expiry, duplicate or hash conflict"
          },
          "503": {
            "description": "Service unavailable"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ]
      },
      "post": {
        "summary": "Record verified guardian",
        "description": "consents.manage; verification actor/time server-owned. Audit omits name/evidence.",
        "security": [
          {
            "UserCookie": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success, data envelope and request_id"
          },
          "400": {
            "description": "Validation or malformed JSON"
          },
          "401": {
            "description": "Session/device unauthenticated"
          },
          "403": {
            "description": "Origin, CSRF or role/grant denied"
          },
          "404": {
            "description": "Scoped reference not found"
          },
          "409": {
            "description": "State, expiry, duplicate or hash conflict"
          },
          "503": {
            "description": "Service unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "full_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "relationship": {
                    "enum": [
                      "parent",
                      "guardian"
                    ]
                  },
                  "verification_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                },
                "required": [
                  "full_name",
                  "relationship",
                  "verification_ref"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
