    "/api/v1/devices/{id}/pairing-token": {
      "post": {
        "summary": "Issue one-time pairing token",
        "description": "devices.manage; random 256-bit token, hashed server storage, five-minute expiry. Response pairing_token/expires_at, no-store; previous token invalidated.",
        "security": [
          {
            "UserCookie": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success, data envelope and request_id"
