  "paths": {
    "/api/v1/school/branding": {
      "get": {
        "summary": "GET /school/branding",
        "description": "Photo access is restricted to the signed-in account. School settings and logo writes require school.write and the existing school administrator policy. Public branding excludes school contact details. Images are rebuilt without metadata and stored in PostgreSQL.",
        "security": [],
        "responses": {
          "200": {
            "description": "Success; JSON data/request_id envelope, or normalized PNG/JPEG for image GET."
          },
          "400": {
            "description": "Invalid form data."
          },
          "401": {
            "description": "Sign-in required."
          },
          "403": {
            "description": "Missing permission or invalid origin/CSRF."
          },
          "404": {
            "description": "Image or active school unavailable."
          },
          "413": {
            "description": "Image exceeds 2 MB."
          },
          "422": {
            "description": "Image cannot be processed."
          }
        }
      }
    },
