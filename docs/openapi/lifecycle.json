    "/api/v1/attendances/check-out": {
      "post": {
        "summary": "Record verified manual departure",
        "description": "attendance.manual; open session within window, present/late check-in prerequisite, no pending correction. Server time, first checkout preserved, actor-scoped event UUID/fingerprint. Response outcome and record including check_out_at/version. Changed payload 409; audit/event/ledger atomic.",
        "security": [
          {
            "UserCookie": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success, data envelope and request_id"
          },
          "400": {
            "description": "Validation or malformed JSON"
          },
          "401": {
            "description": "Session/device unauthenticated"
          },
          "403": {
            "description": "Origin, CSRF or role/grant denied"
